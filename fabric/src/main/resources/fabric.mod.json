{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "accessWidener": "chatplus.accesswidener",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://github.com/InFiniityxSweety/BattleChat/",
    "sources": "https://github.com/InFiniityxSweety/BattleChat/",
    "issues": "https://github.com/InFiniityxSweety/BattleChat/issues/"
  },
  "license": "GPL-3.0",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "com.ebicep.chatplus.fabric.ChatPlusFabric"
      }
    ],
    "modmenu": [
      "com.ebicep.chatplus.config.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "chatplus.mixins.json",
    "chatplus-common.mixins.json"
  ],
  "depends": {
    "fabric-api": "*",
    "minecraft": ">=${min_minecraft_version}",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}"
  }
}
